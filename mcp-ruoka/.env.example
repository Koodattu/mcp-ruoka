# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# OAuth client credentials (for claude.ai and other MCP clients)
# Generate with: openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
PORT=3001

# Optional grocery defaults. Find your own stores with the stores command.
# Examples only; requests can override these with storeId / --store.
# K_RUOKA_STORE_ID=N106
# S_KAUPAT_STORE_ID=513971200
# BROWSER_DATA_DIR=E:/Projektit/mcp-ruoka/.browser-data
# Optional persistent observation database (defaults to .ruoka-data/observations.sqlite).
# RUOKA_DB_PATH=E:/Projektit/mcp-ruoka/.ruoka-data/observations.sqlite
